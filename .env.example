APP_NAME="Dyno Project OS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://demo.dynoprojectos.test

APP_LOCALE=ms
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=dyno
DB_USERNAME=dyno
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@dynoproject.my"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Domain produk — syarikat dipilih dari subdomain (demo.dynoprojectos.test)
DYNO_DOMAIN=dynoprojectos.test
# Pembangunan tempatan sahaja: syarikat untuk http://localhost
DYNO_SYARIKAT_LALAI=demo

# Landing page: butang "Minta demo" (WhatsApp diutamakan, kemudian e-mel)
DYNO_WHATSAPP=
DYNO_EMEL=

# CHIP Collect — daftar sendiri (RM99) & pembaharuan (RM30). Kosong = /daftar tutup.
# Kunci test → purchase test; kunci live → bayaran sebenar.
CHIP_SECRET_KEY=
CHIP_BRAND_ID=
CHIP_PUBLIC_KEY=
DYNO_HARGA_DAFTAR=9900
DYNO_HARGA_PEMBAHARUAN=3000

# Terma & Notis Privasi (/terma, /privasi)
DYNO_PENGENDALI_NAMA="Dyno Project OS"
DYNO_PENGENDALI_SSM=
DYNO_PENGENDALI_ALAMAT=
DYNO_EMEL_PRIVASI=
DYNO_HOSTING="penyedia awan kami"
DYNO_LOKASI_SERVER=Singapura
